# ---------- Server ----------
PORT=5000
# One origin, or a comma-separated list (covers Vite's default port and CRA's default port)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# ---------- MongoDB ----------
# Local: mongodb://127.0.0.1:27017/innovexa-studios
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/innovexa-studios
MONGO_URI=mongodb://127.0.0.1:27017/innovexa-studios

# ---------- Nodemailer (SMTP) ----------
# If using Gmail: enable 2FA on the account, then generate an "App Password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS
# (do NOT use your normal Gmail login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Address that receives new lead notifications
NOTIFY_EMAIL=jefrinabcde@gmail.com
